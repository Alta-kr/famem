{
  "name": "daynote",
  "version": "0.1.2",
  "description": "Daynote — 생각을 기록하고, 일을 계획하고, 성과를 기억하는 데스크톱 메모·업무 관리 앱",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --profile=smoke --smoke",
    "test": "node --test",
    "serve": "node scripts/serve.js",
    "postinstall": "node scripts/fix-electron.js",
    "shots": "electron . --profile=shots --shots",
    "dist": "node scripts/build-win.js"
  },
  "devDependencies": {
    "electron": "32.3.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.27.0"
  },
  "build": {
    "appId": "kr.alta.daynote",
    "productName": "Daynote",
    "copyright": "Daynote",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "quick-preload.js",
      "package.json",
      "renderer/**/*",
      "src/**/*",
      "services/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": "app.env"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daynote",
      "artifactName": "Daynote-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Daynote-${version}-portable.exe"
    }
  }
}
